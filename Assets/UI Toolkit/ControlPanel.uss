.panel-root {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 150px;
    background-color: rgba(0, 0, 0, 0.6);
    flex-direction: row;
    justify-content: space-between;
    padding: 8px;
    gap: 12px;
	

}

.panel-column {
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    padding: 4px;
    border-right-width: 1px;
    border-right-color: gray;
    border-right-style: solid;
}

.resources-panel .unity-label,
.info-panel .unity-label {
    font-size: 12px;
    color: white;
}

.buttons-panel > * {
    margin-bottom: 4px;
}

.empty-panel {
    /* reservado para futuro uso */
}

.info-title {
    font-size: 14px;
    font-weight: bold;
    color: white;
    margin-bottom: 4px;
}
