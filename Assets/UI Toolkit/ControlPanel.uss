.panel-root {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 150px;
    background-color: rgba(0, 0, 0, 0.6);
    flex-direction: row;
    justify-content: space-between;
    padding: 8px;
    gap: 12px;
	

}

.date-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 40px;
    background-color: rgba(0, 0, 0, 0.6);
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding: 0 10px;
}

.date-bar .unity-label {
    color: white;
    font-size: 14px;
}

.panel-column {
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    padding: 4px;
    border-right-width: 1px;
    border-right-color: gray;
    border-right-style: solid;
}

.resources-panel .unity-label,
.info-panel .unity-label {
    font-size: 12px;
    color: white;
}

.buttons-panel {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.buttons-panel > .unity-button {
    margin-right: 4px;
    margin-bottom: 4px;
    flex-grow: 0;
}

.empty-panel {
    /* reservado para futuro uso */
}

.info-title {
    font-size: 14px;
    font-weight: bold;
    color: white;
    margin-bottom: 4px;
}
.resource-box {
    width: 48px;
    height: 60px;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    border: 1px solid gray;
    background-color: rgba(0, 0, 0, 0.4);
    padding: 2px;
    margin-bottom: 4px;
}
.resource-box .resource-icon {
    width: 40px;
    height: 40px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}
.resource-box .unity-label {
    font-size: 12px;
    color: white;
    text-align: center;
    background-color: rgba(255, 255, 255, 0.1);
    padding: 0 2px;
}
.gold-icon { background-image: resource("Icons/gold"); }
.resources-panel {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 0;
    width: 220px;
    gap: 8px;
}
.wood-icon { background-image: resource("Icons/wood"); }
.food-icon { background-image: resource("Icons/food"); }
.crono-icon { background-image: resource("Icons/crono"); }
.worker-icon { background-image: resource("Icons/worker"); }
.soldier-icon { background-image: resource("Icons/soldier"); }
.scientist-icon { background-image: resource("Icons/scientist"); }
.science-icon { background-image: resource("Icons/science"); }

#TimelineSlider {
    flex-grow: 1;
}
